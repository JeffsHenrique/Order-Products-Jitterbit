{
  "name": "order-products",
  "version": "1.0.0",
  "description": "A simple API to order products",
  "main": "index.js",
  "scripts": {
    "start-dev": "tsx watch src/infra/http/server.ts",
    "db-seed": "tsx src/infra/db/seed.ts",
    "db-reset": "tsx src/infra/db/reset-drizzle-db.ts",
    "db-generate": "drizzle-kit generate",
    "db-push": "drizzle-kit push",
    "db-migrate": "drizzle-kit migrate",
    "db-studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "start": "tsx watch src/infra/http/server.ts",
    "start:migrate": "drizzle-kit migrate && npm run start",
    "build": "tsup src/infra/http/server.ts --format cjs,esm --dts --clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@fastify/auth": "^5.0.4",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@scalar/fastify-api-reference": "^1.48.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.8.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.20.0",
    "uuidv7": "1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@faker-js/faker": "^10.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.5",
    "@types/pg": "^8.18.0",
    "@vitest/ui": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "jsonwebtoken": "^9.0.3",
    "swagger-autogen": "^2.23.7",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
